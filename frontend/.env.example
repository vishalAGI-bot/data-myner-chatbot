# Where the Vite dev/preview server forwards API calls (see vite.config.ts)
JOURNEY_BACKEND=http://localhost:8100
ANALYST_BACKEND=http://localhost:8200

# For a production build served from a different origin, point the browser
# straight at the APIs instead (the backends must then allow this origin in CORS_ORIGINS):
# VITE_JOURNEY_API=https://api.example.com/journey
# VITE_ANALYST_API=https://api.example.com/analyst
