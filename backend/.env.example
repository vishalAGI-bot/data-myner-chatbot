# Language model provider: ollama (default) or openai
LLM_PROVIDER=ollama

# OpenAI option. Keep the key server-side; never put it in frontend code.
# Select OpenAI on the Settings page, or set LLM_PROVIDER=openai here.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=none
OPENAI_TIMEOUT=180

# Ollama - no API key, nothing leaves your laptop
OLLAMA_HOST=http://localhost:11434
OLLAMA_NUM_CTX=8192          # MUST stay high: Ollama's 2048 default truncates the schema card
OLLAMA_KEEP_ALIVE=30m        # keep the model in VRAM between questions
OLLAMA_TIMEOUT=180

# --- balanced profile (default): one 7B model, nothing swaps in VRAM ---
SQL_MODEL=qwen2.5-coder:7b
ANSWER_MODEL=qwen2.5-coder:7b
ROUTER_MODEL=qwen2.5-coder:7b

# --- quality profile: better SQL and better prose, but two 9 GB models ---
# SQL_MODEL=qwen2.5-coder:14b
# ANSWER_MODEL=qwen3:14b
# ROUTER_MODEL=granite3.1-moe:3b
# OLLAMA_DISABLE_THINK=1     # qwen3 emits <think> blocks; 1 turns them off

# --- speed profile: fits in ~3 GB ---
# SQL_MODEL=qwen2.5-coder:3b
# ANSWER_MODEL=granite3.1-moe:3b
# ROUTER_MODEL=qwen2.5-coder:1.5b

# Agent: multi-step questions. qwen3:14b is clearly better at tool choice.
USE_AGENT=1
AGENT_MODEL=qwen2.5-coder:7b
MAX_STEPS=5

# --- agent (multi-step tool loop) ---
AGENT_ENABLED=1
AGENT_MAX_STEPS=5            # hard ceiling; without it a confused model loops forever
# AGENT_MODEL=qwen3:14b      # defaults to SQL_MODEL. qwen3 is better at tool choice.

# Semantic lookup with nomic-embed-text (vectors cached to embeddings.npz)
USE_EMBEDDINGS=0
EMBED_MODEL=nomic-embed-text

# Data
TAXONOMY_JSON=data/cat_sample.json
TAXONOMY_DB=taxonomy.db
MAX_SQL_ROWS=200
FUZZY_THRESHOLD=60
FUZZY_TOP_K=8

# --- journey agent (journey_agent/) ---
# JOURNEY_JSON=data/cross-app-journey/data-1790154732687.json
# JOURNEY_PRELOAD=0           # 1 = load JOURNEY_JSON at API start-up
# JOURNEY_STRICT=0            # 1 = reject a file with any bad record instead of quarantining it
# JOURNEY_SQL_TIMEOUT=3       # seconds before a model-written query is stopped
# JOURNEY_MAX_SQL_ROWS=500
# MAX_JOURNEY_UPLOAD_MB=200
# CORS_ORIGINS=https://your-frontend.example.com
# JOURNEY_HOME_APP=Amazon     # which app "we / us / our" means in questions
# JOURNEY_LLM_WORKERS=8        # parallel model calls across users

# ============================ Data analyst (analyst/) - all database tables ============================
# postgres = live datamyner_db (read-only); snapshot = JSON export folder loaded offline
ANALYST_SOURCE=snapshot
ANALYST_SNAPSHOT_DIR=data/public
ANALYST_HOME_APP=Amazon            # who "we / us / our" is
ANALYST_TIMEZONE=Asia/Kolkata      # day boundaries for per-day questions
ANALYST_WINDOW_HOURS=24            # default journey_window
ANALYST_STATEMENT_TIMEOUT_MS=15000 # default for queries with no thinking budget; a chat question
                                   # uses its own "Max thinking time" instead (up to 20 min)
ANALYST_MAX_ROWS=500
ANALYST_ALLOW_FREE_SQL=1           # 0 = only vetted analyses, never model-written SQL
ANALYST_REFRESH_SECONDS=300        # live DB: re-read apps, categories and the latest date this often

# Settings page (web UI). Values saved there go to config/analyst_settings.json and override this file.
# Without a token the page only works on this computer (http://localhost:5173). To use it from another
# computer, set a long random token (e.g. `openssl rand -hex 24`) and enter it on the page.
ANALYST_ADMIN_TOKEN=

# SSH tunnel (leave SSH_HOST empty to connect to the database directly)
SSH_HOST=
SSH_PORT=22
SSH_USERNAME=
SSH_PASSWORD=
# SSH_PKEY=/path/to/private_key    # preferred over a password
# SSH_HOST_KEY_SHA256=SHA256:...    # optional: pin the server's host key (shown on the Settings page)

# PostgreSQL (host/port as seen from the SSH server). Use the read-only role from analyst/sql/readonly_role.sql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=datamyner_db
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=prefer
DB_SCHEMA=public
